<Window x:Class="DiskTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskTune.Controls"
        Title="DiskTune - Diagnóstico, Saúde e Verificação de Superfície de Disco"
        Height="820" Width="1120"
        MinHeight="650" MinWidth="900"
        Background="#0E1217"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo dos Botões Principais -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dos Cards de Métricas -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#181F2C"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#242E42"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Estilo dos Cards de Especificação -->
        <Style x:Key="SpecCard" TargetType="Border">
            <Setter Property="Background" Value="#181F2C"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="BorderBrush" Value="#242E42"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Estilo Dark para ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="4" Margin="2,1">
                            <ContentPresenter Content="{TemplateBinding Content}" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton do ComboBox Dark -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#1E293B"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#334155"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#475569"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Estilo ComboBox Dark -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1217"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#242E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,0,32,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#181F2C" 
                                            BorderBrush="#242E42" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.5" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo TabControl Dark -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Estilo TabItem Dark -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#181F2C"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="#242E42" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="8,8,0,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DataGrid Dark para Atributos SMART -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#141820"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#242E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#141820"/>
            <Setter Property="AlternatingRowBackground" Value="#181F2C"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E293B"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1E293B"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181F2C"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#242E42"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TOP BAR: Seletor de Drive + Recarregar + Botões -->
            <RowDefinition Height="*"/>    <!-- TAB CONTROL COM AS ABAS -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Seletor de Drive e Ações Globais -->
        <Border Grid.Row="0" Background="#181F2C" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#242E42" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Dispositivo:" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1" Name="CmbDisks" Height="38" VerticalContentAlignment="Center"
                          Background="#0E1217" Foreground="#F8FAFC" FontSize="13" Margin="0,0,10,0"
                          SelectionChanged="CmbDisks_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- BOTÃO RECARREGAR DISCOS -->
                <Button Grid.Column="2" Name="BtnRefresh" Content="🔄 Recarregar" Click="BtnRefresh_Click"
                        Background="#1E293B" Foreground="#CBD5E1" Margin="0,0,16,0" Padding="14,8"
                        ToolTip="Detecta novos discos conectados ou removidos sem reiniciar o app"/>

                <!-- Controles do Scan de Superfície -->
                <CheckBox Grid.Column="3" Name="ChkQuickScan" Content="Varredura Rápida (Amostragem)"
                          Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button Grid.Column="4" Name="BtnStart" Content="Iniciar Verificação" Click="BtnStart_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="5" Name="BtnStop" Content="Parar" Background="#DC2626" Click="BtnStop_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- TAB CONTROL COM AS 3 ABAS -->
        <TabControl Grid.Row="1" Name="MainTabControl">
            
            <!-- ========================================== -->
            <!-- ABA 1: VERIFICAÇÃO DE SUPERFÍCIE (ERROR SCAN) -->
            <!-- ========================================== -->
            <TabItem Header="🛡️ Verificação de Superfície">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cards de Métricas -->
                        <RowDefinition Height="*"/>    <!-- Canvas / Block Grid -->
                        <RowDefinition Height="Auto"/> <!-- Legenda & Barra de Progresso -->
                    </Grid.RowDefinitions>

                    <!-- CARDS DE MÉTRICAS -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Velocidade -->
                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="VELOCIDADE ATUAL" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtSpeed" Text="0.0 MB/s" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Posição / LBA -->
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="POSIÇÃO ESCANEADA" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtPosition" Text="0 GB / 0 GB" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tempo Decorrido -->
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="TEMPO / RESTANTE" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtTime" Text="00:00 / --:--" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Blocos Bons -->
                        <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="BLOCOS SAUDÁVEIS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtGoodCount" Text="0 (100%)" Foreground="#22C55E" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Blocos Danificados (Bad Blocks) -->
                        <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="DANIFICADOS / ERROS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtDamagedCount" Text="0" Foreground="#EF4444" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ÁREA CENTRAL: O MAPA DE BLOCOS -->
                    <Border Grid.Row="1" Background="#141820" CornerRadius="8" Padding="12" BorderBrush="#242E42" BorderThickness="1">
                        <controls:BlockCanvas x:Name="CanvasGrid"/>
                    </Border>

                    <!-- RODAPÉ: Legenda e Barra de Progresso Geral -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Progresso -->
                        <ProgressBar Grid.Row="0" Name="PrgTotal" Height="8" Background="#181F2C" Foreground="#2563EB"
                                     BorderThickness="0" Margin="0,0,0,12" Value="0" Maximum="100"/>

                        <!-- Legenda de Cores -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Verde -->
                                <Border Width="12" Height="12" Background="#2ECC71" CornerRadius="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Bom (&lt; 150ms)" Foreground="#94A3B8" FontSize="12" Margin="0,0,18,0"/>

                                <!-- Amarelo -->
                                <Border Width="12" Height="12" Background="#F1C40F" CornerRadius="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Lento (&lt; 500ms)" Foreground="#94A3B8" FontSize="12" Margin="0,0,18,0"/>

                                <!-- Laranja -->
                                <Border Width="12" Height="12" Background="#E67E22" CornerRadius="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Crítico (&lt; 2s)" Foreground="#94A3B8" FontSize="12" Margin="0,0,18,0"/>

                                <!-- Vermelho -->
                                <Border Width="12" Height="12" Background="#E74C3C" CornerRadius="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Danificado / Bad Block" Foreground="#EF4444" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>

                            <!-- Status de texto -->
                            <TextBlock Grid.Column="2" Name="TxtStatus" Text="Pronto para iniciar." Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 2: SAÚDE & S.M.A.R.T. (HEALTH) -->
            <!-- ========================================== -->
            <TabItem Header="❤️ Saúde (S.M.A.R.T.)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Banner de Status Geral -->
                        <RowDefinition Height="Auto"/> <!-- 5 Cards de Métricas Rápidas -->
                        <RowDefinition Height="*"/>    <!-- DataGrid com Atributos SMART -->
                    </Grid.RowDefinitions>

                    <!-- BANNER DE STATUS GERAL -->
                    <Border Grid.Row="0" Name="BdrHealthBanner" Background="#181F2C" CornerRadius="8" Padding="18,14" Margin="0,0,0,16" BorderBrush="#242E42" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge de Status -->
                            <Border Grid.Column="0" Name="BdrHealthBadge" Background="#22C55E" CornerRadius="6" Padding="14,8" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Name="TxtHealthBadge" Text="SAUDÁVEL" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </Border>

                            <!-- Descrição detalhada da saúde -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="DIAGNÓSTICO GERAL DE INTEGRIDADE" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthMessage" Text="O disco está saudável e todos os parâmetros S.M.A.R.T. estão normais."
                                           Foreground="#F8FAFC" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARDS DE MÉTRICAS RÁPIDAS DE SAÚDE -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Temperatura -->
                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="🌡️ TEMPERATURA" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthTemp" Text="-- °C" Foreground="#38BDF8" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Horas Ligado / Tempo de Uso -->
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="⏱️ HORAS LIGADO (USO)" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthPowerHours" Text="-- horas" Foreground="#F8FAFC" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Ciclos de Inicialização -->
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="⚡ CICLOS LIGADO" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthPowerCycles" Text="-- vezes" Foreground="#F8FAFC" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Setores Realocados (05) -->
                        <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="⚠️ SETORES REALOCADOS" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthReallocated" Text="0 setores" Foreground="#22C55E" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Erros de Cabo/CRC (C7) -->
                        <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="🔌 ERROS DE CABO (CRC)" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="TxtHealthCrc" Text="0 erros" Foreground="#22C55E" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TABELA COMPLETA DE ATRIBUTOS S.M.A.R.T. -->
                    <Border Grid.Row="2" Background="#141820" CornerRadius="8" Padding="2" BorderBrush="#242E42" BorderThickness="1">
                        <DataGrid Name="GridSmartAttributes" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID (Hex)" Binding="{Binding IdHex}" Width="75"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdDec}" Width="55"/>
                                <DataGridTextColumn Header="Descrição do Atributo S.M.A.R.T." Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Atual" Binding="{Binding Current}" Width="70"/>
                                <DataGridTextColumn Header="Pior" Binding="{Binding Worst}" Width="70"/>
                                <DataGridTextColumn Header="Limiar" Binding="{Binding Threshold}" Width="70"/>
                                <DataGridTextColumn Header="Valor Bruto (Interpretado)" Binding="{Binding RawFormatted}" Width="230"/>
                                
                                <!-- Status Badge com cor -->
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 3: INFORMAÇÕES DO DISCO (SPECS & VOLUMES) -->
            <!-- ========================================== -->
            <TabItem Header="ℹ️ Informações do Disco">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SEÇÃO 1: IDENTIFICAÇÃO E HARDWARE -->
                        <Border Style="{StaticResource SpecCard}">
                            <StackPanel>
                                <TextBlock Text="IDENTIFICAÇÃO DO DISPOSITIVO" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,12">
                                        <TextBlock Text="Modelo:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoModel" Text="--" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,12">
                                        <TextBlock Text="Número de Série:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoSerial" Text="--" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="Revisão de Firmware:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoFirmware" Text="--" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                                        <TextBlock Text="Caminho do Dispositivo Físico:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoDeviceId" Text="--" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,10,0">
                                        <TextBlock Text="Status do Windows:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoStatus" Text="OK" Foreground="#22C55E" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1">
                                        <TextBlock Text="ID PNP:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoPnp" Text="--" Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: INTERFACE, MÍDIA E CAPACIDADE -->
                        <Border Style="{StaticResource SpecCard}">
                            <StackPanel>
                                <TextBlock Text="INTERFACE E CAPACIDADE DE ARMAZENAMENTO" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,12">
                                        <TextBlock Text="Tipo de Interface / Barramento:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoBusType" Text="SATA" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,12">
                                        <TextBlock Text="Tipo de Mídia:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoMediaType" Text="HDD / SSD" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="Capacidade Total:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoCapacity" Text="0 GB" Foreground="#22C55E" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                                        <TextBlock Text="Tamanho Exato em Bytes:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoTotalBytes" Text="0 Bytes" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,10,0">
                                        <TextBlock Text="Total de Setores (LBA):" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoSectors" Text="0" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1">
                                        <TextBlock Text="Bytes por Setor:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoSectorSize" Text="512 Bytes" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: GEOMETRIA DO DISCO -->
                        <Border Style="{StaticResource SpecCard}">
                            <StackPanel>
                                <TextBlock Text="GEOMETRIA DO DISCO FÍSICO" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Total de Cilindros:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoCylinders" Text="--" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Total de Cabeças:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoHeads" Text="--" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Trilhas por Cilindro:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoTracksPerCyl" Text="--" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Setores por Trilha:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Name="TxtInfoSectorsPerTrack" Text="--" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 4: PARTIÇÕES E VOLUMES ASSOCIADOS -->
                        <Border Style="{StaticResource SpecCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="VOLUMES E PARTIÇÕES MONTADAS" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                
                                <ItemsControl Name="LstPartitions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141820" CornerRadius="6" Padding="14,12" Margin="0,0,0,10" BorderBrush="#242E42" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Cabeçalho do volume -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FileSystem}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SummaryText}" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <!-- Barra de uso do volume -->
                                                    <ProgressBar Grid.Row="1" Height="8" Background="#1E293B" Foreground="#2563EB"
                                                                 BorderThickness="0" Margin="0,8,0,0" Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Name="TxtNoPartitions" Text="Nenhuma partição com letra de unidade encontrada neste disco."
                                           Foreground="#94A3B8" FontSize="13" FontStyle="Italic" Visibility="Collapsed" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
